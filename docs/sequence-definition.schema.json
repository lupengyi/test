{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/industrial-test-platform/sequence-definition.schema.json",
  "title": "SequenceDefinition",
  "type": "object",
  "required": ["name", "version", "station", "productId", "processId", "steps"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "station": {
      "type": "object",
      "required": ["stationId", "processId", "lineId", "stationName"],
      "properties": {
        "stationId": { "type": "string" },
        "processId": { "type": "string" },
        "lineId": { "type": "string" },
        "stationName": { "type": "string" }
      }
    },
    "productId": { "type": "string" },
    "processId": { "type": "string" },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "defaultValue"],
        "properties": {
          "name": { "type": "string" },
          "defaultValue": { "type": ["string", "number", "boolean", "object", "array", "null"] },
          "description": { "type": "string" }
        }
      }
    },
    "hooks": {
      "type": "object",
      "properties": {
        "preUutLoop": { "$ref": "#/definitions/stepList" },
        "preUut": { "$ref": "#/definitions/stepList" },
        "postUut": { "$ref": "#/definitions/stepList" },
        "postUutLoop": { "$ref": "#/definitions/stepList" }
      }
    },
    "steps": { "$ref": "#/definitions/stepList" }
  },
  "definitions": {
    "stepList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/stepDefinition" }
    },
    "stepDefinition": {
      "type": "object",
      "required": ["id", "name", "plugin"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "plugin": { "type": "string" },
        "inputs": { "type": "object" },
        "limitsRef": { "type": "string" },
        "timeout": { "type": "string", "format": "duration" },
        "retry": {
          "type": "object",
          "required": ["maxRetries", "mode"],
          "properties": {
            "maxRetries": { "type": "integer", "minimum": 0 },
            "delay": { "type": "string", "format": "duration" },
            "mode": {
              "type": "string",
              "enum": ["None", "Immediate", "FixedDelay", "ExponentialBackoff"]
            }
          }
        },
        "condition": {
          "type": "object",
          "required": ["expression", "onFalse"],
          "properties": {
            "expression": { "type": "string" },
            "onFalse": { "type": "string", "enum": ["Skip", "Abort"] }
          }
        }
      }
    }
  }
}
